{
  "name": "ynx",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ci:install": "npm ci && npm run install:infra",
    "install:infra": "npm --prefix infra/bridge-service ci && npm --prefix infra/ai-gateway ci && npm --prefix infra/web4-hub install --no-package-lock",
    "postinstall": "npm --workspaces --if-present run build",
    "test": "npm run test:packages && npm run test:infra",
    "test:packages": "npm --workspaces run test",
    "test:infra": "npm --prefix infra/bridge-service test && npm --prefix infra/ai-gateway test && npm --prefix infra/web4-hub test",
    "lint": "npm run lint:packages",
    "lint:packages": "npm --workspaces run lint",
    "format": "npm run format:packages",
    "format:packages": "npm --workspaces run format",
    "verify:docs": "./scripts/verify_docs_readiness.sh",
    "security:verify": "node scripts/security-platform.mjs verify",
    "security:test": "node --test scripts/security-platform.test.mjs scripts/security-backup.test.mjs scripts/security-artifact.test.mjs",
    "security:artifact": "node scripts/security-artifact.mjs build",
    "security:backup": "node scripts/security-backup.mjs"
  }
}
